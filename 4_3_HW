      "source": [
        "# 1. Generate samples from y = (1 + a)*x + b + noise\n",
        "rng = np.random.default_rng(42)\n",
        "X = np.linspace(-5, 5, 200).reshape(-1, 1)\n",
        "\n",
        "a_true = 1.5\n",
        "b_true = -0.75\n",
        "noise = rng.normal(0, 0.2, size=X.shape)\n",
        "Y = (1 + a_true) * X + b_true + noise\n",
        "\n",
        "# 2. Compute H and the right-hand-side vector\n",
        "H = compute_H(X, Y)\n",
        "rhs = compute_b(X, Y)\n",
        "\n",
        "# 3. Estimate the parameters\n",
        "a_hat, b_hat = np.linalg.solve(H, rhs).ravel()\n",
        "\n",
        "# 4. Compare known and estimated values\n",
        "print(f\"True:      a = {a_true:.4f}, b = {b_true:.4f}\")\n",
        "print(f\"Estimated: a = {a_hat:.4f}, b = {b_hat:.4f}\")"
      ],
