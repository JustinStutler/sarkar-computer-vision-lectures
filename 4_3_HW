        "id": "linear-estimation-03"
      },
      "source": [
        "## Computing H and b without loops"
      ],
      "id": "linear-estimation-03"
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "linear-estimation-04"
      },
      "source": [
        "def compute_H(X, Y):\n",
        "  A = np.hstack((X, np.ones_like(X)))\n",
        "  return A.T @ A\n",
        "\n",
        "def compute_b(X, Y):\n",
        "  A = np.hstack((X, np.ones_like(X)))\n",
        "  return A.T @ (Y - X)"
      ],
      "execution_count": 3,
      "outputs": [],
      "id": "linear-estimation-04"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "linear-estimation-05"
      },
      "source": [
        "## Synthetic test"
      ],
      "id": "linear-estimation-05"
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "linear-estimation-06",
        "outputId": "33201e0d-0b07-4241-eeb6-e781ec4076f9"
      },
      "source": [
        "|rng = np.random.default_rng(67)\n",
        "X = np.linspace(-5, 5, 200).reshape(-1, 1)\n",
        "\n",
        "a_true = 1.5\n",
        "b_true = -0.75\n",
        "noise = rng.normal(0, 0.2, size=X.shape)\n",
        "Y = (1 + a_true) * X + b_true + noise\n",
        "\n",
        "H = compute_H(X, Y)\n",
        "rhs = compute_b(X, Y)\n",
        "\n",
        "a_hat, b_hat = np.linalg.solve(H, rhs).ravel()\n",
        "\n",
        "print(f\"True:      a = {a_true:.4f}, b = {b_true:.4f}\")\n",
        "print(f\"Estimated: a = {a_hat:.4f}, b = {b_hat:.4f}\")\n",
        "print(\"H shape:\", H.shape, \"b shape:\", rhs.shape)\n",
        "print(\"Absolute errors:\", np.abs([a_hat - a_true, b_hat - b_true]))\n",
        "assert H.shape == (2, 2) and rhs.shape == (2, 1)\n",
        "np.testing.assert_allclose([a_hat, b_hat], [a_true, b_true], atol=0.05, rtol=0)\n",
        "\n",
        "Y_exact = (1 + a_true) * X + b_true\n",
        "exact = np.linalg.solve(compute_H(X, Y_exact), compute_b(X, Y_exact)).ravel()\n",
        "np.testing.assert_allclose(exact, [a_true, b_true], atol=1e-12, rtol=0)\n",
        "print(\"Shape, noisy recovery, and noiseless recovery checks passed.\")"
      ],
      "execution_count": 4,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "True:      a = 1.5000, b = -0.7500\n",
            "Estimated: a = 1.5066, b = -0.7579\n",
            "H shape: (2, 2) b shape: (2, 1)\n",
            "Absolute errors: [0.0066 0.0079]\n",
            "Shape, noisy recovery, and noiseless recovery checks passed.\n"
          ]
        }
      ],
      "id": "linear-estimation-06"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "linear-estimation-07"
      },
      "source": [
        "## Sensitivity to outlier matches"
      ],
      "id": "linear-estimation-07"
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "linear-estimation-08"
      },
      "source": [
        "def fit_affine(P, Q):\n",
        "    A = np.column_stack((P, np.ones(len(P))))\n",
        "\n",
        "    coefficients = np.linalg.lstsq(A, Q, rcond=None)[0]\n",
        "\n",
        "    T = np.eye(3)\n",
        "    T[:2] = coefficients.T\n",
        "\n",
        "    errors = np.linalg.norm(A @ coefficients - Q, axis=1)\n",
        "    return T, errors\n",
        "\n",
        "def compare_matches(image_1, image_2, output_dir=\"results\"):\n",
        "    output_dir = Path(output_dir)\n",
        "    output_dir.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "    sift = cv2.SIFT_create()\n",
        "    k1, d1 = sift.detectAndCompute(image_1, None)\n",
        "    k2, d2 = sift.detectAndCompute(image_2, None)\n",
        "\n",
        "    matcher = cv2.BFMatcher(cv2.NORM_L1, crossCheck=True)\n",
        "    matches = sorted(matcher.match(d1, d2), key=lambda m: m.distance)\n",
        "\n",
        "    results = []\n",
        "\n",
        "    for n in (8, 10, 20):\n",
        "        selected = matches[:n]\n",
        "        P = np.array([k1[m.queryIdx].pt for m in selected])\n",
        "        Q = np.array([k2[m.trainIdx].pt for m in selected])\n",
        "\n",
        "        T, errors = fit_affine(P, Q)\n",
        "\n",
        "        cv2.setRNGSeed(42)\n",
        "        model, mask = cv2.estimateAffine2D(\n",
        "            P, Q,\n",
        "            method=cv2.RANSAC,\n",
        "            ransacReprojThreshold=3,\n",
        "            maxIters=5000,\n",
        "            confidence=0.99,\n",
        "            refineIters=10\n",
        "        )\n",
        "\n",
        "        inliers = mask.ravel().astype(bool)\n",
        "        T_robust, inlier_errors = fit_affine(P[inliers], Q[inliers])\n",
        "\n",
        "        A = np.column_stack((P, np.ones(len(P))))\n",
        "        robust_errors = np.linalg.norm(A @ T_robust[:2].T - Q, axis=1)\n",
        "        results.append({\n",
        "            \"NUM_MATCHES\": n,\n",
        "            \"LS_RMSE_px\": np.sqrt(np.mean(errors**2)),\n",
        "            \"RANSAC_all_RMSE_px\": np.sqrt(np.mean(robust_errors**2)),\n",
        "            \"RANSAC_inliers\": int(inliers.sum()),\n",
        "            \"LS_inlier_RMSE_px\": np.sqrt(np.mean(errors[inliers]**2)),\n",
        "            \"RANSAC_inlier_RMSE_px\": np.sqrt(np.mean(inlier_errors**2))\n",
        "        })\n",
        "\n",
        "        match_image = cv2.drawMatches(\n",
        "            image_1, k1, image_2, k2, selected, None,\n",
        "            matchColor=(0, 220, 0), flags=2\n",
        "        )\n",
        "        cv2.imwrite(str(output_dir / f\"matches_{n}.png\"), match_image)\n",
        "\n",
        "        size = (image_2.shape[1], image_2.shape[0])\n",
        "\n",
        "        for name, transform in ((\"LS\", T), (\"RANSAC\", T_robust)):\n",
        "            warped = cv2.warpAffine(image_1, transform[:2], size)\n",
        "            overlay = np.dstack((image_2, image_2, warped))\n",
        "            cv2.imwrite(\n",
        "                str(output_dir / f\"overlay_{name}_{n}.png\"),\n",
        "                overlay\n",
        "            )\n",
        "\n",
        "    return results"
      ],
      "execution_count": 5,
      "outputs": [],
      "id": "linear-estimation-08"
    },
