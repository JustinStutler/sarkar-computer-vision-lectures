    {
      "cell_type": "markdown",
      "source": [
        "# Helper Functions"
      ],
      "metadata": {
        "id": "vMypP0aFMI65"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def init_weights(m):\n",
        "    if type(m) == nn.Linear:\n",
        "        nn.init.normal_(m.weight, std=0.01)\n",
        "\n",
        "def run_experiment(batch_size, lr, num_epochs=30, seed=0):\n",
        "    torch.manual_seed(seed)                       # same starting weights for every run\n",
        "    net = nn.Sequential(nn.Flatten(), nn.Linear(784, 10)).to(device)\n",
        "    net.apply(init_weights)\n",
        "    loss_fn = nn.CrossEntropyLoss()\n",
        "    opt = torch.optim.SGD(net.parameters(), lr=lr)\n",
        "\n",
        "    n = Xtr.shape[0]\n",
        "    history = []\n",
        "    for epoch in range(1, num_epochs + 1):\n",
        "        net.train()\n",
        "        perm = torch.randperm(n, device=device)   # shuffle each epoch\n",
        "        loss_sum = torch.zeros((), device=device)\n",
        "        correct  = torch.zeros((), device=device)\n",
        "\n",
        "        for i in range(0, n, batch_size):\n",
        "            idx = perm[i:i + batch_size]\n",
        "            X, y = Xtr[idx], ytr[idx]\n",
        "            y_hat = net(X)\n",
        "            l = loss_fn(y_hat, y)\n",
        "            opt.zero_grad(set_to_none=True)\n",
        "            l.backward()\n",
        "            opt.step()\n",
        "            loss_sum += l.detach() * len(idx)     # stays on GPU, no sync\n",
        "            correct  += (y_hat.argmax(1) == y).sum()\n",
        "\n",
        "        # Test accuracy: one forward pass over all 10k test images\n",
        "        net.eval()\n",
        "        with torch.no_grad():\n",
        "            test_acc = (net(Xte).argmax(1) == yte).float().mean().item()\n",
        "\n",
        "        history.append({'batch_size': batch_size, 'lr': lr, 'epoch': epoch,\n",
        "                        'train_loss': loss_sum.item() / n,\n",
        "                        'train_acc':  correct.item() / n,\n",
        "                        'test_acc':   test_acc})\n",
        "    return history"
      ],
      "metadata": {
        "id": "30oee8eSHALs"
      },
