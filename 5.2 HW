        "\n",
        "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
        "print('Using:', device)   # should print \"cuda\"\n",
        "\n",
        "train_ds = torchvision.datasets.FashionMNIST(root='../data', train=True,  download=True)\n",
        "test_ds  = torchvision.datasets.FashionMNIST(root='../data', train=False, download=True)\n",
        "\n",
        "# Scale pixels to [0, 1] (same as ToTensor in d2l) and move everything to the GPU once\n",
        "Xtr = train_ds.data.float().div(255).unsqueeze(1).to(device)   # shape (60000, 1, 28, 28)\n",
        "ytr = train_ds.targets.to(device)\n",
        "Xte = test_ds.data.float().div(255).unsqueeze(1).to(device)    # shape (10000, 1, 28, 28)\n",
        "yte = test_ds.targets.to(device)"
      ],
      "metadata": {
