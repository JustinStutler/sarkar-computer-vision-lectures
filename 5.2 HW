        "batch_sizes = [256, 128, 64]\n",
        "lrs = [0.1, 0.01, 0.2]\n",
        "\n",
        "all_history = []\n",
        "start = time.time()\n",
        "for bs in batch_sizes:\n",
        "    for lr in lrs:\n",
        "        t0 = time.time()\n",
        "        all_history += run_experiment(bs, lr, num_epochs=30)\n",
        "        print(f'batch={bs:3d}  lr={lr:<4}  done in {time.time() - t0:.1f}s')\n",
        "print(f'Total: {time.time() - start:.1f}s')\n",
        "\n",
        "hist_df = pd.DataFrame(all_history)"
