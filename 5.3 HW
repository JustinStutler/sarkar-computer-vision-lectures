      "source": [
        "# Created for checking for overfitting\n",
        "# Inspect the generalization gap.\n",
        "def plot_overfitting(run):\n",
        "    h = run[\"history\"]\n",
        "    fig, ax = plt.subplots(figsize=(9, 5))\n",
        "    ax.plot(h[\"epoch\"], h[\"train_acc\"], \"o--\", label=\"Train (during epoch)\")\n",
        "    ax.plot(h[\"epoch\"], h[\"test_acc\"], \"s-\", label=\"Test (after epoch)\")\n",
        "    ax.axvspan(6, 10, color=\"gray\", alpha=0.12, label=\"Late training\")\n",
        "    ax.set(xlabel=\"Epoch\", ylabel=\"Accuracy\", ylim=(0.78, 0.96),\n",
        "           title=\"Mild overfitting: LeakyReLU, batch 32, Xavier normal\")\n",
        "    ax.grid(alpha=0.25)\n",
        "    ax.legend()\n",
        "    fig.tight_layout()\n",
        "    plt.show()\n",
        "    return fig"
      ],
