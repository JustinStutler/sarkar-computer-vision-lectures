      "source": [
        "## Learning curves\n",
        "\n",
        "We created these plots to compare accuracy across runs."
      ],
      "id": "tgSXH7kOMfTJ"
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "v7NIkuEgMfTJ"
      },
      "source": [
        "# Created for comparing learning curves\n",
        "# Compare learning curves.\n",
        "def _plot_runs(runs, title):\n",
        "    fig, ax = plt.subplots(figsize=(9, 5))\n",
        "    for index, (label, run) in enumerate(runs.items()):\n",
        "        h = run[\"history\"]\n",
        "        color = f\"C{index}\"\n",
        "        ax.plot(h[\"epoch\"], h[\"train_acc\"], color=color, linestyle=\"--\",\n",
        "                label=f\"{label}: train\")\n",
        "        ax.plot(h[\"epoch\"], h[\"test_acc\"], color=color, linestyle=\"-\",\n",
        "                marker=\"o\", label=f\"{label}: test\")\n",
        "    ax.set(xlabel=\"Epoch\", ylabel=\"Accuracy\", title=title, ylim=(0, 1))\n",
        "    if \"initialization\" in title:\n",
        "        ax.set_ylim(0.60, 0.90)\n",
        "    ax.legend(fontsize=8)\n",
        "    ax.grid(alpha=0.25)\n",
        "    fig.tight_layout()\n",
        "    return fig\n",
        "\n",
        "\n",
        "# Created for comparing the best runs\n",
        "# Compare winning configurations.\n",
        "def plot_winners_clear(results):\n",
        "    winners = best_options(results)\n",
        "    fig, ax = plt.subplots(figsize=(10, 5))\n",
        "    markers = [\"o\", \"s\", \"^\"]\n",
        "    for i, (parameter, option) in enumerate(winners.items()):\n",
        "        h = results[parameter][option][\"history\"]\n",
        "\n",
        "        for metric, style, split in [(\"train_acc\", \"--\", \"train\"),\n",
        "                                      (\"test_acc\", \"-\", \"test\")]:\n",
        "            ax.plot(h[\"epoch\"], h[metric], color=f\"C{i}\", linestyle=style,\n",
        "                    marker=markers[i], markevery=(i, 3), markersize=7,\n",
        "                    markerfacecolor=\"none\", label=f\"{parameter}={option}: {split}\")\n",
        "    ax.set(xlabel=\"Epoch\", ylabel=\"Accuracy\", ylim=(0.60, 0.97),\n",
        "           title=\"Best option from each experiment\")\n",
        "    if winners.get(\"batch_size\") == 32 and winners.get(\"initialization\") == \"xavier_normal\":\n",
        "        ax.text(0.02, 0.03, \"Batch 32 and Xavier winners are the same Sigmoid baseline;\\n\"\n",
        "                \"their curves may overlap.\", transform=ax.transAxes, fontsize=9)\n",
        "    ax.grid(alpha=0.25)\n",
        "    ax.legend(fontsize=8)\n",
        "    fig.tight_layout()\n",
        "    plt.show()\n",
        "    return fig"
      ],
