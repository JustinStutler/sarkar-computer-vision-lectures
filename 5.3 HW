    {
      "cell_type": "markdown",
      "metadata": {
        "id": "tkAJxWlkMfTG"
      },
      "source": [
        "## Model and weights\n",
        "\n",
        "Adapted from notes to compare activation functions and starting weights."
      ],
      "id": "tkAJxWlkMfTG"
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "Azi_MsvxMfTG"
      },
      "source": [
        "# Created for choosing activation functions\n",
        "# Choose hidden-layer behavior.\n",
        "def make_activation(name):\n",
        "    factories = {\n",
        "        \"sigmoid\": nn.Sigmoid,\n",
        "        \"softmax\": lambda: nn.Softmax(dim=1),\n",
        "        \"relu\": nn.ReLU,\n",
        "        \"leaky_relu\": lambda: nn.LeakyReLU(negative_slope=0.01),\n",
        "    }\n",
        "    if name not in factories:\n",
        "        raise ValueError(f\"Unknown activation: {name}\")\n",
        "    return factories[name]()\n",
        "\n",
        "\n",
        "# Adapted from notes\n",
        "# Build the classification network.\n",
        "def Lenet(activation=\"sigmoid\"):\n",
        "    return nn.Sequential(\n",
        "        nn.Conv2d(1, 6, kernel_size=5, padding=2),\n",
        "        make_activation(activation),\n",
        "        nn.AvgPool2d(kernel_size=2, stride=2),\n",
        "        nn.Conv2d(6, 16, kernel_size=5),\n",
        "        make_activation(activation),\n",
        "        nn.AvgPool2d(kernel_size=2, stride=2),\n",
        "        nn.Flatten(),\n",
        "        nn.Linear(16 * 5 * 5, 120),\n",
        "        make_activation(activation),\n",
        "        nn.Linear(120, 84),\n",
        "        make_activation(activation),\n",
        "        nn.Linear(84, 10),\n",
        "    )\n",
        "\n",
        "\n",
        "# Adapted from notes\n",
        "# Set starting weights.\n",
        "def initialize_weights(net, initialization=\"xavier_normal\"):\n",
        "    if initialization not in (\"default\", \"xavier_normal\", \"kaiming_normal\"):\n",
        "        raise ValueError(f\"Unknown initialization: {initialization}\")\n",
        "    for layer in net.modules():\n",
        "        if isinstance(layer, (nn.Conv2d, nn.Linear)):\n",
        "            if initialization == \"xavier_normal\":\n",
        "                nn.init.xavier_normal_(layer.weight)\n",
        "            elif initialization == \"kaiming_normal\":\n",
        "                nn.init.kaiming_normal_(layer.weight)"
      ],
      "execution_count": 3,
      "outputs": [],
      "id": "Azi_MsvxMfTG"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "StIReqM-MfTH"
      },
      "source": [
        "## Batches and evaluation\n",
        "\n",
        "We created these helpers to prepare batches and measure loss and accuracy."
      ],
      "id": "StIReqM-MfTH"
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "Zyt-DqOwMfTH"
      },
      "source": [
        "# Created for preparing repeatable batches\n",
        "# Repeatable shuffled batches.\n",
        "def make_loaders(trainset, testset, batch_size=32, seed=42):\n",
        "    generator = torch.Generator().manual_seed(seed)\n",
        "    train_iter = DataLoader(trainset, batch_size=batch_size, shuffle=True,\n",
        "                            generator=generator, num_workers=0)\n",
        "    test_iter = DataLoader(testset, batch_size=batch_size, shuffle=False,\n",
        "                           num_workers=0)\n",
        "    return train_iter, test_iter\n",
        "\n",
        "\n",
        "# Created for measuring loss and accuracy\n",
        "# Measure unseen-data performance.\n",
        "@torch.no_grad()\n",
        "def evaluate(net, data_iter, loss_fn, device):\n",
        "    net.eval()\n",
        "    total_loss, correct, count = 0.0, 0, 0\n",
        "    for X, y in data_iter:\n",
        "        X, y = X.to(device), y.to(device)\n",
        "        logits = net(X)\n",
        "        total_loss += loss_fn(logits, y).item() * y.size(0)\n",
        "        correct += (logits.argmax(dim=1) == y).sum().item()\n",
        "        count += y.size(0)\n",
        "    return total_loss / count, correct / count"
      ],
      "execution_count": 4,
      "outputs": [],
      "id": "Zyt-DqOwMfTH"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "H5BVFOV_MfTH"
      },
      "source": [
        "## Training metrics\n",
        "\n",
        "Taken and adapted from notes to track accuracy and train for one epoch."
      ],
      "id": "H5BVFOV_MfTH"
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "v7b7NorEMfTI"
      },
      "source": [
        "# Taken from notes\n",
        "# Track sample-weighted totals.\n",
        "class Accumulator:\n",
        "    # Taken from notes\n",
        "    def __init__(self, n):\n",
        "        self.data = [0.0] * n\n",
        "\n",
        "    # Taken from notes\n",
        "    def add(self, *args):\n",
        "        self.data = [a + float(b) for a, b in zip(self.data, args)]\n",
        "\n",
        "    # Taken from notes\n",
        "    def reset(self):\n",
        "        self.data = [0.0] * len(self.data)\n",
        "\n",
        "    # Taken from notes\n",
        "    def __getitem__(self, idx):\n",
        "        return self.data[idx]\n",
        "\n",
        "\n",
        "# Taken from notes\n",
        "# Count correct predictions.\n",
        "def accuracy(y_hat, y):\n",
        "    if len(y_hat.shape) > 1 and y_hat.shape[1] > 1:\n",
        "        y_hat = y_hat.argmax(axis=1)\n",
        "    cmp = y_hat.type(y.dtype) == y\n",
        "    return float(cmp.type(y.dtype).sum())\n",
        "\n",
        "\n",
        "# Adapted from notes\n",
        "# Learn from one dataset pass.\n",
        "def train_one_epoch(net, train_iter, loss, updater, device):\n",
        "    net.train()\n",
        "    metric = Accumulator(3)\n",
        "    for X, y in train_iter:\n",
        "        X, y = X.to(device), y.to(device)\n",
        "        y_hat = net(X)\n",
        "        l = loss(y_hat, y)\n",
        "        updater.zero_grad()\n",
        "        l.backward()\n",
        "        updater.step()\n",
        "        metric.add(l.item() * len(y), accuracy(y_hat, y), y.numel())\n",
        "    return metric[0] / metric[2], metric[1] / metric[2]"
      ],
      "execution_count": 5,
      "outputs": [],
      "id": "v7b7NorEMfTI"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "2J-MfBSFMfTI"
      },
      "source": [
        "## Training a run\n",
        "\n",
        "We created this helper to train a configuration; the submission uses completed runs."
      ],
      "id": "2J-MfBSFMfTI"
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "0nwUMO_DMfTI"
      },
      "source": [
        "# Created for training one configuration\n",
        "# Train one configuration.\n",
        "def run_experiment(\n",
        "    trainset, testset, *, batch_size=32, initialization=\"xavier_normal\",\n",
        "    activation=\"sigmoid\", lr=0.001, num_epochs=10, seed=42, device=None\n",
        "):\n",
        "    if num_epochs < 1 or len(trainset) == 0 or len(testset) == 0:\n",
        "        raise ValueError(\"Use positive epochs and nonempty datasets.\")\n",
        "    config = dict(\n",
        "        batch_size=batch_size, initialization=initialization, activation=activation,\n",
        "        lr=lr, num_epochs=num_epochs, optimizer=\"Adam\", seed=seed\n",
        "    )\n",
        "    torch.manual_seed(seed)\n",
        "    if torch.cuda.is_available():\n",
        "        torch.cuda.manual_seed_all(seed)\n",
        "    device = torch.device(device or (\"cuda:0\" if torch.cuda.is_available() else \"cpu\"))\n",
        "    net = Lenet(activation)\n",
        "    initialize_weights(net, initialization)\n",
        "    net.to(device)\n",
        "    train_iter, test_iter = make_loaders(trainset, testset, batch_size, seed)\n",
        "    loss_fn = nn.CrossEntropyLoss()\n",
        "    optimizer = torch.optim.Adam(net.parameters(), lr=lr)\n",
        "    history = {key: [] for key in (\n",
        "        \"epoch\", \"train_loss\", \"train_acc\", \"test_loss\", \"test_acc\"\n",
        "    )}\n",
        "\n",
        "    for epoch in range(1, num_epochs + 1):\n",
        "        train_loss, train_acc = train_one_epoch(\n",
        "            net, train_iter, loss_fn, optimizer, device\n",
        "        )\n",
        "        test_loss, test_acc = evaluate(net, test_iter, loss_fn, device)\n",
        "        values = (epoch, train_loss, train_acc, test_loss, test_acc)\n",
        "        for key, value in zip(history, values):\n",
        "            history[key].append(value)\n",
        "        print(f\"Epoch {epoch:2d}/{num_epochs}: \"\n",
        "              f\"train acc={train_acc:.3%}, test acc={test_acc:.3%}\")\n",
        "\n",
        "    return dict(\n",
        "        config=config, history=history, model=net.cpu(), complete=True,\n",
        "        final_test_acc=history[\"test_acc\"][-1]\n",
        "    )"
      ],
      "execution_count": 6,
      "outputs": [],
