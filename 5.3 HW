      "source": [
        "## Experiment settings\n",
        "\n",
        "We defined the baseline and options for each experiment."
      ],
      "id": "YpcCo4z0MfTG"
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "PG4IDQSuMfTG"
      },
      "source": [
        "BASELINE = dict(batch_size=32, initialization=\"xavier_normal\",\n",
        "                activation=\"sigmoid\", lr=0.001, num_epochs=10)\n",
        "VARIATIONS = {\n",
        "    \"batch_size\": [32, 64, 128],\n",
        "    \"initialization\": [\"default\", \"xavier_normal\", \"kaiming_normal\"],\n",
        "    \"activation\": [\"softmax\", \"relu\", \"leaky_relu\"],\n",
        "}"
