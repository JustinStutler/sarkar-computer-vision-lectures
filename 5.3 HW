        "## Layer activations\n",
        "\n",
        "We created these plots to show how the model responds to a pullover and a coat."
      ],
      "id": "BJ7cqsdwMfTK"
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "8hnh8gHQMfTK"
      },
      "source": [
        "# Created for showing layer activations\n",
        "# See learned image responses.\n",
        "@torch.no_grad()\n",
        "def plot_layer_activations(run, dataset):\n",
        "    if not run.get(\"complete\", True):\n",
        "        raise ValueError(\"Use a completed experiment checkpoint.\")\n",
        "    net = run[\"model\"]\n",
        "    device = next(net.parameters()).device\n",
        "    samples = []\n",
        "    for class_id, name in [(2, \"Pullover\"), (4, \"Coat\")]:\n",
        "        for index in range(len(dataset)):\n",
        "            X, y = dataset[index]\n",
        "            if int(y) == class_id:\n",
        "                samples.append((index, name, X, class_id))\n",
        "                break\n",
        "        else:\n",
        "            raise ValueError(f\"Dataset has no {name} examples.\")\n",
        "    X = torch.stack([sample[2] for sample in samples]).to(device)\n",
        "    was_training = net.training\n",
        "    net.eval()\n",
        "    maps = {}\n",
        "    try:\n",
        "        hidden = X\n",
        "        for index, layer in enumerate(net):\n",
        "            hidden = layer(hidden)\n",
        "            if index in (1, 4):\n",
        "                maps[index] = hidden.detach().cpu()\n",
        "        predictions = hidden.argmax(dim=1).cpu().tolist()\n",
        "    finally:\n",
        "        net.train(was_training)\n",
        "    assert tuple(maps[1].shape) == (2, 6, 28, 28)\n",
        "    assert tuple(maps[4].shape) == (2, 16, 10, 10)\n",
        "    classes = [\"T-shirt/top\", \"Trouser\", \"Pullover\", \"Dress\", \"Coat\",\n",
        "               \"Sandal\", \"Shirt\", \"Sneaker\", \"Bag\", \"Ankle boot\"]\n",
        "    figures = []\n",
        "    for sample_idx, (data_index, name, sample, label) in enumerate(samples):\n",
        "        fig, axes = plt.subplots(4, 8, figsize=(16, 9), layout=\"constrained\")\n",
        "        for ax in axes.flat:\n",
        "            ax.axis(\"off\")\n",
        "        axes[0, 0].imshow((sample.squeeze(0).cpu() * 0.5 + 0.5).clamp(0, 1),\n",
        "                         cmap=\"gray\", vmin=0, vmax=1)\n",
        "        axes[0, 0].set_title(\"Input 28 × 28\")\n",
        "        axes[0, 2].text(0, 0.5, f\"True class: {name}\\n\"\n",
        "                        f\"Prediction: {classes[predictions[sample_idx]]}\\n\"\n",
        "                        f\"Test index: {data_index}\", fontsize=12)\n",
        "        for layer_index, row, channels, title in [\n",
        "                (1, 1, 6, \"Layer 1\"), (4, 2, 16, \"Layer 2\")]:\n",
        "            bound = max(maps[layer_index].abs().max().item(), 1e-8)\n",
        "            layer_axes = []\n",
        "            for channel in range(channels):\n",
        "                ax = axes[row + channel // 8, channel % 8]\n",
        "                im = ax.imshow(maps[layer_index][sample_idx, channel].numpy(),\n",
        "                               cmap=\"RdBu_r\", vmin=-bound, vmax=bound)\n",
        "                ax.set_title(f\"{title}, ch {channel + 1}\", fontsize=9)\n",
        "                layer_axes.append(ax)\n",
        "            fig.colorbar(im, ax=layer_axes, shrink=0.65, label=\"Activation\")\n",
        "        fig.suptitle(f\"{name}: trained LeNet post-activation feature maps\\n\"\n",
        "                     f\"{run['config']['activation']}; layer 1: 6 × 28 × 28; \"\n",
        "                     \"layer 2: 16 × 10 × 10\", fontsize=14)\n",
        "        figures.append(fig)\n",
        "        print(f\"{name}: test index {data_index}, predicted \"\n",
        "              f\"{classes[predictions[sample_idx]]}\")\n",
        "    plt.show()\n",
        "    return figures, maps"
      ],
