      "source": [
        "Oh = torch.normal(0, 1, (2, 5))\n",
        "Y_prob = softmax(Oh)\n",
        "print('Oh =\\n', Oh)\n",
        "print('Y_prob =\\n', Y_prob, '\\nSum=', Y_prob.sum(1))"
