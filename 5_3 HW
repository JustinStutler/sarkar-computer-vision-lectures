    {
      "cell_type": "markdown",
      "metadata": {
        "id": "ONAh5WTL1ELn"
      },
      "source": [
        "## Model and weights\n",
        "\n",
        "Adapted from notes to compare activation functions and starting weights."
      ],
      "id": "ONAh5WTL1ELn"
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "Juch8Geu1ELn"
      },
      "source": [
        "# Created for choosing activation functions\n",
        "# Choose hidden-layer behavior.\n",
        "def make_activation(name):\n",
        "    factories = {\n",
        "        \"sigmoid\": nn.Sigmoid,\n",
        "        \"softmax\": lambda: nn.Softmax(dim=1),\n",
        "        \"relu\": nn.ReLU,\n",
        "        \"leaky_relu\": lambda: nn.LeakyReLU(negative_slope=0.01),\n",
        "    }\n",
        "    if name not in factories:\n",
        "        raise ValueError(f\"Unknown activation: {name}\")\n",
        "    return factories[name]()\n",
        "\n",
        "\n",
        "# Adapted from notes\n",
        "# Build the classification network.\n",
        "def Lenet(activation=\"sigmoid\"):\n",
        "    return nn.Sequential(\n",
        "        nn.Conv2d(1, 6, kernel_size=5, padding=2),\n",
        "        make_activation(activation),\n",
        "        nn.AvgPool2d(kernel_size=2, stride=2),\n",
        "        nn.Conv2d(6, 16, kernel_size=5),\n",
        "        make_activation(activation),\n",
        "        nn.AvgPool2d(kernel_size=2, stride=2),\n",
        "        nn.Flatten(),\n",
        "        nn.Linear(16 * 5 * 5, 120),\n",
        "        make_activation(activation),\n",
        "        nn.Linear(120, 84),\n",
        "        make_activation(activation),\n",
        "        nn.Linear(84, 10),\n",
        "    )\n",
        "\n",
        "\n",
        "# Adapted from notes\n",
        "# Set starting weights.\n",
        "def initialize_weights(net, initialization=\"xavier_normal\"):\n",
        "    if initialization not in (\"default\", \"xavier_normal\", \"kaiming_normal\"):\n",
        "        raise ValueError(f\"Unknown initialization: {initialization}\")\n",
        "    for layer in net.modules():\n",
        "        if isinstance(layer, (nn.Conv2d, nn.Linear)):\n",
        "            if initialization == \"xavier_normal\":\n",
        "                nn.init.xavier_normal_(layer.weight)\n",
        "            elif initialization == \"kaiming_normal\":\n",
        "                nn.init.kaiming_normal_(layer.weight)"
      ],
      "execution_count": 3,
      "outputs": [],
      "id": "Juch8Geu1ELn"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "vHarRPvd1ELo"
      },
      "source": [
        "## Batches and evaluation\n",
        "\n",
        "helper functions to prepare batches and measure loss and accuracy."
      ],
      "id": "vHarRPvd1ELo"
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "VqvAwkXQ1ELo"
      },
      "source": [
        "# Created for preparing repeatable batches\n",
        "# Repeatable shuffled batches.\n",
        "def make_loaders(trainset, testset, batch_size=32, seed=42):\n",
        "    generator = torch.Generator().manual_seed(seed)\n",
        "    train_iter = DataLoader(trainset, batch_size=batch_size, shuffle=True,\n",
        "                            generator=generator, num_workers=0)\n",
        "    test_iter = DataLoader(testset, batch_size=batch_size, shuffle=False,\n",
        "                           num_workers=0)\n",
        "    return train_iter, test_iter\n",
        "\n",
        "\n",
        "# Created for measuring loss and accuracy\n",
        "# Measure unseen-data performance.\n",
        "@torch.no_grad()\n",
        "def evaluate(net, data_iter, loss_fn, device):\n",
        "    net.eval()\n",
        "    total_loss, correct, count = 0.0, 0, 0\n",
        "    for X, y in data_iter:\n",
        "        X, y = X.to(device), y.to(device)\n",
        "        logits = net(X)\n",
        "        total_loss += loss_fn(logits, y).item() * y.size(0)\n",
        "        correct += (logits.argmax(dim=1) == y).sum().item()\n",
        "        count += y.size(0)\n",
        "    return total_loss / count, correct / count"
      ],
      "execution_count": 4,
      "outputs": [],
      "id": "VqvAwkXQ1ELo"
    },
    {
      "cell_type": "markdown",
