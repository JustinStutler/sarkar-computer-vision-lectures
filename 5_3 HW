        "    with torch.no_grad():\n",
        "        for index, layer in enumerate(model):\n",
        "            X = layer(X)\n",
        "\n",
        "            # Outputs after the first and second activations.\n",
        "            if index in (1, 4):\n",
        "                feature_maps.append(X[0].cpu())\n",
        "\n",
        "            if index == 4:\n",
        "                break\n",
        "\n",
        "    plt.figure(figsize=(3, 3))\n",
        "    plt.imshow(image[0] * 0.5 + 0.5, cmap=\"gray\")\n",
