        "## Learning curves"
      ],
      "id": "4cerIKQb1ELp"
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "sHF3_DgL1ELp"
      },
      "source": [
        "from math import ceil, floor\n",
        "from matplotlib.ticker import MultipleLocator, PercentFormatter\n",
        "\n",
        "PLOT_COLORS = (\"#0072B2\", \"#D55E00\", \"#009E73\")\n",
        "PLOT_MARKERS = (\"o\", \"s\", \"^\")\n",
        "\n",
        "\n",
        "# Created for matching plot scales across experiments\n",
        "# Find shared accuracy limits.\n",
        "def accuracy_limits(results, first_epoch=1):\n",
        "    values = [\n",
        "        value\n",
        "        for runs in results.values()\n",
        "        for run in runs.values()\n",
        "        for metric in (\"train_acc\", \"test_acc\")\n",
        "        for epoch, value in zip(run[\"history\"][\"epoch\"], run[\"history\"][metric])\n",
        "        if epoch >= first_epoch\n",
        "    ]\n",
        "    lower = max(0, floor((min(values) - 0.005) / 0.05) * 0.05)\n",
        "    upper = min(1, ceil((max(values) + 0.005) / 0.05) * 0.05)\n",
        "    return lower, upper\n",
        "\n",
        "\n",
        "# Created for keeping plot labels readable\n",
        "# Format option names.\n",
        "def plot_label(value):\n",
        "    labels = {\n",
        "        \"default\": \"Default\", \"xavier_normal\": \"Xavier normal\",\n",
        "        \"kaiming_normal\": \"Kaiming normal\", \"sigmoid\": \"Sigmoid\",\n",
        "        \"softmax\": \"Softmax\", \"relu\": \"ReLU\", \"leaky_relu\": \"LeakyReLU\",\n",
        "    }\n",
        "    return labels.get(str(value), str(value).replace(\"_\", \" \"))\n",
        "\n",
        "\n",
        "# Created for comparing learning curves\n",
        "# Compare learning curves.\n",
        "def _plot_runs(runs, title, note=\"\"):\n",
        "    full_limits = accuracy_limits(results)\n",
        "    zoom_limits = accuracy_limits(results, first_epoch=6)\n",
        "    fig, axes = plt.subplots(\n",
        "        1, 2, figsize=(14, 5.8), gridspec_kw={\"width_ratios\": [1, 1.6]}\n",
        "    )\n",
        "    for index, (label, run) in enumerate(runs.items()):\n",
        "        history = run[\"history\"]\n",
        "        color = PLOT_COLORS[index % len(PLOT_COLORS)]\n",
        "        marker = PLOT_MARKERS[index % len(PLOT_MARKERS)]\n",
        "        label = plot_label(label)\n",
        "        final_accuracy = history[\"test_acc\"][-1]\n",
        "        for ax in axes:\n",
        "            ax.plot(\n",
        "                history[\"epoch\"], history[\"train_acc\"], color=color,\n",
        "                linestyle=\"--\", linewidth=1.6, alpha=0.8,\n",
        "                label=f\"{label}: train\"\n",
        "            )\n",
        "            ax.plot(\n",
        "                history[\"epoch\"], history[\"test_acc\"], color=color,\n",
        "                linestyle=\"-\", linewidth=2, marker=marker, markersize=6,\n",
        "                markerfacecolor=\"white\", markeredgewidth=1.4,\n",
        "                markevery=(index, 3) if note else 1,\n",
        "                label=f\"{label}: test ({final_accuracy:.2%} final)\"\n",
        "            )\n",
        "\n",
        "    for ax, limits, x_limits, subtitle in zip(\n",
        "        axes, (full_limits, zoom_limits), ((1, 10), (6, 10)),\n",
        "        (\"All epochs\", \"Late training: epochs 6–10\")\n",
        "    ):\n",
        "        ax.set(\n",
        "            xlabel=\"Epoch\", ylabel=\"Accuracy\", xlim=x_limits,\n",
        "            ylim=limits, title=subtitle\n",
        "        )\n",
        "        ax.xaxis.set_major_locator(MultipleLocator(1))\n",
        "        ax.yaxis.set_major_formatter(PercentFormatter(xmax=1, decimals=0))\n",
        "        ax.yaxis.set_major_locator(MultipleLocator(0.05))\n",
        "        ax.grid(axis=\"y\", color=\"#D8DEE5\", linewidth=0.7)\n",
        "        ax.set_axisbelow(True)\n",
        "        ax.spines[[\"top\", \"right\"]].set_visible(False)\n",
        "        ax.tick_params(labelsize=10)\n",
        "    axes[0].axvspan(6, 10, color=\"#0072B2\", alpha=0.06)\n",
        "    axes[1].yaxis.set_minor_locator(MultipleLocator(0.01))\n",
        "    axes[1].grid(axis=\"y\", which=\"minor\", color=\"#E9EDF1\", linewidth=0.5)\n",
        "    fig.suptitle(title, fontsize=15, fontweight=\"semibold\", y=0.98)\n",
        "    handles, labels = axes[0].get_legend_handles_labels()\n",
        "    fig.legend(\n",
        "        handles, labels, loc=\"lower center\", bbox_to_anchor=(0.5, 0.045),\n",
        "        ncol=min(len(runs), 3), frameon=False, fontsize=9\n",
        "    )\n",
        "    caption = \"Matching scales across plots; zoomed axes do not start at zero.\"\n",
        "    if note:\n",
        "        caption += \" \" + note\n",
        "    fig.text(0.5, 0.015, caption, ha=\"center\", fontsize=9, color=\"#495360\")\n",
        "    fig.tight_layout(rect=(0, 0.16, 1, 0.93))\n",
        "    return fig\n",
        "\n",
        "\n",
        "# Created for comparing the best runs\n",
        "# Compare winning configurations.\n",
        "def plot_winners_clear(results):\n",
        "    winners = best_options(results)\n",
        "    best_runs = {\n",
        "        f\"{parameter.replace('_', ' ')}: {plot_label(option)}\": results[parameter][option]\n",
        "        for parameter, option in winners.items()\n",
        "    }\n",
        "    note = \"\"\n",
        "    if winners.get(\"batch_size\") == 32 and winners.get(\"initialization\") == \"xavier_normal\":\n",
        "        note = \"Batch 32 and Xavier share a baseline; curves may overlap.\"\n",
        "    fig = _plot_runs(best_runs, \"Best option from each experiment\", note=note)\n",
        "    plt.show()\n",
        "    return fig"
      ],
