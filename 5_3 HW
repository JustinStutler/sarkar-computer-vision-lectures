        "## Training function records each epoch"
      ],
      "metadata": {
        "id": "DkxJp_ac3oWY"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def evaluate_loss(net, data_iter, loss):\n",
        "    net.eval()\n",
        "    metric = Accumulator(2)\n",
        "\n",
        "    with torch.no_grad():\n",
        "        for X, y in data_iter:\n",
        "            X, y = X.to(device), y.to(device)\n",
        "            metric.add(loss(net(X), y).item() * y.numel(), y.numel())\n",
        "\n",
        "    return metric[0] / metric[1]\n",
        "\n",
        "\n",
        "def train_full_history(net, train_iter, test_iter, num_epochs, lr,\n",
        "                       initialization=\"xavier_normal\",\n",
        "                       train_eval_iter=None,\n",
        "                       record_losses=False):\n",
        "\n",
        "    # ---------------- Initialize ----------------\n",
        "    def init_weights(m):\n",
        "        if type(m) == nn.Linear or type(m) == nn.Conv2d:\n",
        "            if initialization == \"xavier_normal\":\n",
        "                nn.init.xavier_normal_(m.weight)\n",
        "            elif initialization == \"kaiming_normal\":\n",
        "                nn.init.kaiming_normal_(m.weight)\n",
        "\n",
        "    if initialization == \"default\":\n",
        "        pass  # Keep the fresh model's PyTorch initialization\n",
        "    elif initialization in (\"xavier_normal\", \"kaiming_normal\"):\n",
        "        net.apply(init_weights)\n",
        "    else:\n",
        "        raise ValueError(\"Unknown initialization\")\n",
        "\n",
        "    net.to(device)\n",
        "\n",
        "    # ---------------- Loss and optimizer ----------------\n",
        "    loss = nn.CrossEntropyLoss()\n",
        "    optimizer = torch.optim.Adam(net.parameters(), lr=lr)\n",
        "\n",
        "    if train_eval_iter is None:\n",
        "        train_eval_iter = train_iter\n",
        "\n",
        "    history = []\n",
        "\n",
        "    # ---------------- Iterate over epochs ----------------\n",
        "    for epoch in range(num_epochs):\n",
        "        train_metrics = train_one_epoch(net, train_iter, loss, optimizer)\n",
        "\n",
        "        train_acc = evaluate_accuracy(net, train_eval_iter)\n",
        "        test_acc = evaluate_accuracy(net, test_iter)\n",
        "\n",
        "        row = {\n",
        "            \"epoch\": epoch + 1,\n",
        "            \"train_acc\": train_acc,\n",
        "            \"test_acc\": test_acc\n",
        "        }\n",
        "\n",
        "        if record_losses:\n",
        "            row[\"train_loss\"] = evaluate_loss(net, train_eval_iter, loss)\n",
        "            row[\"test_loss\"] = evaluate_loss(net, test_iter, loss)\n",
        "\n",
        "        history.append(row)\n",
        "\n",
        "        if epoch == 0 or (epoch + 1) % 5 == 0:\n",
        "            print(\n",
        "                f\"Epoch {epoch + 1}/{num_epochs}: \"\n",
        "                f\"train accuracy = {train_acc:.4f}, \"\n",
        "                f\"test accuracy = {test_acc:.4f}\"\n",
        "            )\n",
        "\n",
        "    return pd.DataFrame(history)"
      ],
