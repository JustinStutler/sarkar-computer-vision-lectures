    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "QBvvedIP1ELp",
        "outputId": "d9c9fe6f-39b7-4a1e-fa51-b9f53eacd086"
      },
      "source": [
        "RUNS_DIR = Path(\"/content/drive/MyDrive/lenet_cache\")\n",
        "\n",
        "if str(RUNS_DIR).startswith(\"/content/drive/\") and not RUNS_DIR.is_dir():\n",
        "    from google.colab import drive\n",
        "\n",
        "    drive.mount(\"/content/drive\")\n",
        "if not RUNS_DIR.is_dir():\n",
        "    raise FileNotFoundError(f\"Set RUNS_DIR to the completed-run folder: {RUNS_DIR}\")\n",
        "\n",
        "results = {parameter: {} for parameter in VARIATIONS}\n",
        "for run_path in sorted(RUNS_DIR.glob(\"*.pt\")):\n",
        "    saved = torch.load(run_path, map_location=\"cpu\", weights_only=True)\n",
        "    identity = saved.get(\"identity\", {})\n",
        "    if (identity.get(\"version\") != 1\n",
        "            or identity.get(\"dataset_id\") != \"fashion_mnist_normalized_v1\"):\n",
        "        continue\n",
        "    config = identity.get(\"config\", {})\n",
        "    for parameter, options in VARIATIONS.items():\n",
        "        for option in options:\n",
        "            expected = {**BASELINE, parameter: option, \"optimizer\": \"Adam\", \"seed\": 42}\n",
        "            if config != expected or identity.get(\"run_id\") != f\"{parameter}={option}\":\n",
        "                continue\n",
        "            if saved.get(\"epoch\") != config[\"num_epochs\"]:\n",
        "                continue\n",
        "            history = saved[\"history\"]\n",
        "            metrics = (\"epoch\", \"train_loss\", \"train_acc\", \"test_loss\", \"test_acc\")\n",
        "            if (any(len(history.get(key, [])) != config[\"num_epochs\"] for key in metrics)\n",
        "                    or history[\"epoch\"] != list(range(1, config[\"num_epochs\"] + 1))):\n",
        "                raise ValueError(f\"Incomplete learning history: {run_path.name}\")\n",
        "            if option in results[parameter]:\n",
        "                raise ValueError(f\"Multiple completed runs for {parameter}={option}.\")\n",
        "            with torch.random.fork_rng(devices=[]):\n",
        "                net = Lenet(config[\"activation\"])\n",
        "            net.load_state_dict(saved[\"model_state\"])\n",
        "            net.eval()\n",
        "            results[parameter][option] = dict(\n",
        "                config=config, history=history, model=net, complete=True,\n",
        "                final_test_acc=history[\"test_acc\"][-1]\n",
        "            )\n",
        "\n",
        "missing = [\n",
        "    f\"{parameter}={option}\"\n",
        "    for parameter, options in VARIATIONS.items()\n",
        "    for option in options if option not in results[parameter]\n",
        "]\n",
        "if missing:\n",
        "    raise FileNotFoundError(\"Missing completed runs: \" + \", \".join(missing))\n",
        "results = {\n",
        "    parameter: {option: results[parameter][option] for option in options}\n",
        "    for parameter, options in VARIATIONS.items()\n",
        "}\n",
        "print(f\"Loaded {sum(len(runs) for runs in results.values())} completed runs.\")"
      ],
