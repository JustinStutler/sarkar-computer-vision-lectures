        "CACHE_VERIFIED = False\n",
        "drive.mount(\"/content/drive\")\n",
        "DRIVE_ROOT = Path(\"/content/drive/MyDrive\")\n",
        "if not DRIVE_ROOT.is_dir():\n",
        "    raise RuntimeError(\"Google Drive is unavailable. Training has not started.\")\n",
        "\n",
        "# NEW: fixed absolute paths survive notebook and runtime restarts.\n",
        "CACHE_DIR = DRIVE_ROOT / \"lenet_cache\"\n",
        "RESULTS_DIR = CACHE_DIR / \"results\"\n",
        "FIGURES_DIR = CACHE_DIR / \"figures\"\n",
        "for folder in (CACHE_DIR, RESULTS_DIR, FIGURES_DIR):\n",
        "    folder.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "# NEW: our experiment, persistence, or plotting helper.\n",
        "def atomic_write_text(path, content):\n",
        "    path = Path(path)\n",
        "    path.parent.mkdir(parents=True, exist_ok=True)\n",
        "    temporary = None\n",
        "    try:\n",
        "        with tempfile.NamedTemporaryFile(mode=\"w\", encoding=\"utf-8\",\n",
        "                                         dir=path.parent, suffix=\".tmp\",\n",
        "                                         delete=False) as stream:\n",
        "            temporary = Path(stream.name)\n",
        "            stream.write(content)\n",
        "            stream.flush()\n",
        "            os.fsync(stream.fileno())\n",
        "        os.replace(temporary, path)\n",
        "    finally:\n",
        "        if temporary is not None:\n",
        "            temporary.unlink(missing_ok=True)\n",
        "\n",
        "# NEW: our experiment, persistence, or plotting helper.\n",
        "def _atomic_save(payload, path):\n",
        "    path = Path(path)\n",
        "    path.parent.mkdir(parents=True, exist_ok=True)\n",
        "    temporary = None\n",
        "    try:\n",
        "        with tempfile.NamedTemporaryFile(dir=path.parent, suffix=\".tmp\",\n",
        "                                         delete=False) as stream:\n",
        "            temporary = Path(stream.name)\n",
        "            torch.save(payload, stream)\n",
        "            stream.flush()\n",
        "            os.fsync(stream.fileno())\n",
        "        os.replace(temporary, path)\n",
        "    finally:\n",
        "        if temporary is not None:\n",
        "            temporary.unlink(missing_ok=True)\n",
        "\n",
        "# NEW: test the same checkpoint writer used by the real experiments.\n",
        "# NEW: isolate the test's random numbers from the experiment seed.\n",
        "with torch.random.fork_rng(devices=[]):\n",
        "    test_model = torch.nn.Linear(2, 1)\n",
        "    test_optimizer = torch.optim.Adam(test_model.parameters(), lr=0.001)\n",
        "    test_input = torch.tensor([[1.0, 2.0]])\n",
        "    test_optimizer.zero_grad()\n",
        "    test_model(test_input).square().mean().backward()\n",
        "    test_optimizer.step()\n",
        "    expected = test_model(test_input).detach().clone()\n",
        "\n",
        "    # NEW: temporary test files live on Drive and do not touch real checkpoints.\n",
        "    with tempfile.TemporaryDirectory(prefix=\"cache_debug_\", dir=CACHE_DIR) as folder:\n",
        "        probe = Path(folder) / \"checkpoint.pt\"\n",
        "        payload = {\n",
        "            \"epoch\": 1,\n",
        "            \"model_state\": test_model.state_dict(),\n",
        "            \"optimizer_state\": test_optimizer.state_dict(),\n",
        "            \"torch_rng\": torch.get_rng_state(),\n",
        "            \"history\": {\"test_acc\": [0.5]},\n",
