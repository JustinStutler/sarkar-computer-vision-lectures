        "    plt.axis(\"off\")\n",
        "    plt.show()\n",
        "\n",
        "    for layer_number, maps in enumerate(feature_maps, start=1):\n",
        "        channels = maps.shape[0]\n",
        "        cols = min(8, channels)\n",
        "        rows = int(np.ceil(channels / cols))\n",
        "\n",
        "        fig, axes = plt.subplots(\n",
        "            rows,\n",
        "            cols,\n",
        "            figsize=(2 * cols, 2.2 * rows),\n",
        "            squeeze=False\n",
        "        )\n",
        "\n",
        "        # Common scale across channels within this layer/image.\n",
        "        vmin = maps.min().item()\n",
        "        vmax = maps.max().item()\n",
        "\n",
        "        for channel, ax in enumerate(axes.flat):\n",
        "            if channel < channels:\n",
        "                ax.imshow(\n",
        "                    maps[channel],\n",
        "                    cmap=\"gray\",\n",
        "                    vmin=vmin,\n",
        "                    vmax=vmax\n",
        "                )\n",
        "                ax.set_title(f\"Channel {channel}\")\n",
        "            ax.axis(\"off\")\n",
        "\n",
        "        fig.suptitle(\n",
        "            f\"{class_names[label]} — \"\n",
        "            f\"Convolution {layer_number}, after activation\"\n",
        "        )\n",
