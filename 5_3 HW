      "source": [
        "# Created for selecting the best options\n",
        "# Select final-epoch winners.\n",
        "def best_options(results):\n",
        "    return {\n",
        "        parameter: max(runs, key=lambda option: runs[option][\"final_test_acc\"])\n",
        "        for parameter, runs in results.items()\n",
        "    }\n",
        "\n",
        "\n",
        "# Created for building the results table\n",
        "# Collect comparable results.\n",
        "def summary_rows(results):\n",
        "    winners = best_options(results)\n",
        "    return [\n",
        "        dict(experiment=parameter, option=option,\n",
        "             **run[\"config\"],\n",
        "             final_train_acc=run[\"history\"][\"train_acc\"][-1],\n",
        "             final_test_acc=run[\"final_test_acc\"],\n",
        "             selected=(option == winners[parameter]))\n",
        "        for parameter, runs in results.items()\n",
        "        for option, run in runs.items()\n",
        "    ]"
      ],
      "execution_count": 8,
