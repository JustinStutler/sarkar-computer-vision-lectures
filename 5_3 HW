      "source": [
        "# LeNet hyperparameter experiments\n",
        "Standalone helper notebook using the supplied architecture and baseline. Run cells in order. Requires torch, torchvision, matplotlib, and pandas.\n",
        "\n",
        "Each experiment resets the random seed and creates a fresh model, loaders, and Adam optimizer. GPU operations can still vary between runs. Train accuracy is accumulated during training, as in the source notebook; test accuracy is evaluated after each epoch.\n",
        "\n",
        "Only the named hyperparameter changes. Bias initialization stays at the PyTorch default, matching the source notebook. Kaiming uses `nn.init.kaiming_normal_` defaults while retaining Sigmoid in the initialization comparison. Hidden Softmax uses `dim=1`: channels for convolution outputs and features for dense outputs. The output layer always returns raw logits.\n",
        "\n",
        "Winners use **final-epoch test accuracy**, per your plan. The batch-size=32 and initialization=Xavier runs intentionally repeat the baseline. Sigmoid is the fixed baseline, not an additional candidate in the three-option activation experiment. The fourth figure compares the three separate winners; it does not combine their settings.\n"
      ],
      "id": "lenet-0"
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "lenet-1"
      },
      "source": [
        "\"\"\"LeNet experiment helpers; use with the notebook's trainset and testset.\"\"\"\n",
        "import torch\n",
        "from torch import nn\n",
        "from torch.utils.data import DataLoader\n",
        "import matplotlib.pyplot as plt\n",
        "import hashlib\n",
        "import json\n",
        "import os\n",
        "from pathlib import Path\n",
        "import tempfile\n",
        "\n",
        "\n",
        "CACHE_VERSION = 1  # Increment if model/training implementation changes.\n",
        "\n",
        "\n",
        "def _atomic_save(payload, path):\n",
        "    \"\"\"A failed write leaves the previous epoch's checkpoint intact.\"\"\"\n",
        "    path = Path(path)\n",
        "    path.parent.mkdir(parents=True, exist_ok=True)\n",
        "    temporary = None\n",
        "    try:\n",
        "        with tempfile.NamedTemporaryFile(dir=path.parent, suffix=\".tmp\",\n",
        "                                         delete=False) as stream:\n",
        "            temporary = Path(stream.name)\n",
        "            torch.save(payload, stream)\n",
        "            stream.flush()\n",
        "            os.fsync(stream.fileno())\n",
        "        os.replace(temporary, path)\n",
        "    finally:\n",
        "        if temporary is not None:\n",
        "            temporary.unlink(missing_ok=True)\n",
        "\n",
        "\n",
        "def load_experiment(checkpoint_path):\n",
        "    \"\"\"Load a saved model and history on CPU, without training or datasets.\"\"\"\n",
        "    saved = torch.load(checkpoint_path, map_location=\"cpu\", weights_only=True)\n",
        "    if saved[\"identity\"][\"version\"] != CACHE_VERSION:\n",
        "        raise ValueError(\"Checkpoint uses a different helper version.\")\n",
        "    config = saved[\"identity\"][\"config\"]\n",
        "    # Loading should not change the caller's CPU random sequence.\n",
        "    with torch.random.fork_rng(devices=[]):\n",
        "        net = Lenet(config[\"activation\"])\n",
        "    net.load_state_dict(saved[\"model_state\"])\n",
        "    net.eval()\n",
        "    complete = saved[\"epoch\"] == config[\"num_epochs\"]\n",
        "    return dict(config=config, history=saved[\"history\"], model=net,\n",
        "                complete=complete, checkpoint_path=str(checkpoint_path),\n",
        "                final_test_acc=saved[\"history\"][\"test_acc\"][-1] if complete else None)\n",
        "\n",
        "\n",
        "BASELINE = dict(batch_size=32, initialization=\"xavier_normal\",\n",
        "                activation=\"sigmoid\", lr=0.001, num_epochs=10)\n",
        "VARIATIONS = {\n",
        "    \"batch_size\": [32, 64, 128],\n",
        "    \"initialization\": [\"default\", \"xavier_normal\", \"kaiming_normal\"],\n",
        "    \"activation\": [\"softmax\", \"relu\", \"leaky_relu\"],\n",
        "}\n",
        "\n",
        "\n",
        "def make_activation(name):\n",
        "    factories = {\n",
        "        \"sigmoid\": nn.Sigmoid,\n",
        "        \"softmax\": lambda: nn.Softmax(dim=1),\n",
        "        \"relu\": nn.ReLU,\n",
        "        \"leaky_relu\": lambda: nn.LeakyReLU(negative_slope=0.01),\n",
        "    }\n",
        "    if name not in factories:\n",
        "        raise ValueError(f\"Unknown activation: {name}\")\n",
        "    return factories[name]()\n",
        "\n",
        "\n",
        "def Lenet(activation=\"sigmoid\"):\n",
        "    \"\"\"Same 61,706-parameter architecture as the supplied notebook.\"\"\"\n",
        "    return nn.Sequential(\n",
        "        nn.Conv2d(1, 6, kernel_size=5, padding=2),\n",
        "        make_activation(activation),\n",
        "        nn.AvgPool2d(kernel_size=2, stride=2),\n",
        "        nn.Conv2d(6, 16, kernel_size=5),\n",
        "        make_activation(activation),\n",
        "        nn.AvgPool2d(kernel_size=2, stride=2),\n",
        "        nn.Flatten(),\n",
        "        nn.Linear(16 * 5 * 5, 120),\n",
        "        make_activation(activation),\n",
        "        nn.Linear(120, 84),\n",
        "        make_activation(activation),\n",
        "        nn.Linear(84, 10),  # Raw logits for CrossEntropyLoss.\n",
        "    )\n",
        "\n",
        "\n",
        "def initialize_weights(net, initialization=\"xavier_normal\"):\n",
        "    \"\"\"Initialize weights once; preserve default biases, as in the notebook.\"\"\"\n",
        "    if initialization not in (\"default\", \"xavier_normal\", \"kaiming_normal\"):\n",
        "        raise ValueError(f\"Unknown initialization: {initialization}\")\n",
        "    for layer in net.modules():\n",
        "        if isinstance(layer, (nn.Conv2d, nn.Linear)):\n",
        "            if initialization == \"xavier_normal\":\n",
        "                nn.init.xavier_normal_(layer.weight)\n",
        "            elif initialization == \"kaiming_normal\":\n",
        "                # Matches the notebook's suggested nn.init.kaiming_normal_ call.\n",
        "                nn.init.kaiming_normal_(layer.weight)\n",
        "            # \"default\" leaves the new model's constructor initialization intact.\n",
        "\n",
        "\n",
        "def make_loaders(trainset, testset, batch_size=32, seed=42):\n",
        "    # Separate generator keeps data ordering independent of initialization RNG.\n",
        "    generator = torch.Generator().manual_seed(seed)\n",
        "    train_iter = DataLoader(trainset, batch_size=batch_size, shuffle=True,\n",
        "                            generator=generator, num_workers=0)\n",
        "    test_iter = DataLoader(testset, batch_size=batch_size, shuffle=False,\n",
        "                           num_workers=0)\n",
        "    return train_iter, test_iter\n",
        "\n",
        "\n",
        "@torch.no_grad()\n",
        "def evaluate(net, data_iter, loss_fn, device):\n",
        "    net.eval()\n",
        "    total_loss, correct, count = 0.0, 0, 0\n",
        "    for X, y in data_iter:\n",
        "        X, y = X.to(device), y.to(device)\n",
        "        logits = net(X)\n",
        "        total_loss += loss_fn(logits, y).item() * y.size(0)\n",
        "        correct += (logits.argmax(dim=1) == y).sum().item()\n",
        "        count += y.size(0)\n",
        "    return total_loss / count, correct / count\n",
        "\n",
        "\n",
        "def run_experiment(trainset, testset, *, batch_size=32,\n",
        "                   initialization=\"xavier_normal\", activation=\"sigmoid\",\n",
        "                   lr=0.001, num_epochs=10, seed=42, device=None,\n",
        "                   cache_dir=\"lenet_cache\", resume=True,\n",
        "                   dataset_id=\"fashion_mnist_normalized_v1\", run_id=\"single\"):\n",
        "    \"\"\"Load, resume, or train an experiment, saving after every complete epoch.\n",
        "\n",
        "    train_acc is measured during training, matching the original notebook.\n",
        "    test_acc/test_loss are evaluated after each epoch. Accuracies are fractions.\n",
        "    Change dataset_id for new data/splits/transforms, and CACHE_VERSION for code\n",
        "    changes. Use resume=False to rerun and replace a matching cache, or\n",
        "    cache_dir=None to disable disk caching. Do not run concurrent writers for\n",
        "    the same configuration/run_id. Checkpoints cover this notebook's PyTorch\n",
        "    randomness; custom random transforms may need additional RNG state.\n",
        "    \"\"\"\n",
        "    if num_epochs < 1 or len(trainset) == 0 or len(testset) == 0:\n",
        "        raise ValueError(\"Use positive epochs and nonempty datasets.\")\n",
        "    config = dict(batch_size=batch_size, initialization=initialization,\n",
        "                  activation=activation, lr=lr, num_epochs=num_epochs,\n",
        "                  optimizer=\"Adam\", seed=seed)\n",
        "    identity = dict(version=CACHE_VERSION, config=config, dataset_id=dataset_id,\n",
        "                    train_size=len(trainset), test_size=len(testset),\n",
        "                    train_transform=repr(getattr(trainset, \"transform\", None)),\n",
        "                    test_transform=repr(getattr(testset, \"transform\", None)),\n",
        "                    run_id=run_id)\n",
        "    checkpoint_path = None\n",
        "    saved = None\n",
        "    if cache_dir is not None:\n",
        "        key = hashlib.sha256(json.dumps(identity, sort_keys=True).encode()).hexdigest()\n",
        "        checkpoint_path = Path(cache_dir) / f\"{key}.pt\"\n",
        "        if resume and checkpoint_path.exists():\n",
        "            saved = torch.load(checkpoint_path, map_location=\"cpu\", weights_only=True)\n",
        "            if saved[\"identity\"] != identity:\n",
        "                raise ValueError(\"Checkpoint configuration mismatch.\")\n",
        "            if saved[\"epoch\"] == num_epochs:\n",
        "                print(f\"Loaded completed experiment: {checkpoint_path}\")\n",
        "                return load_experiment(checkpoint_path)\n",
        "    torch.manual_seed(seed)\n",
        "    if torch.cuda.is_available():\n",
        "        torch.cuda.manual_seed_all(seed)\n",
        "    device = torch.device(device or (\"cuda:0\" if torch.cuda.is_available() else \"cpu\"))\n",
        "    net = Lenet(activation)\n",
        "    initialize_weights(net, initialization)\n",
        "    net.to(device)\n",
        "    train_iter, test_iter = make_loaders(trainset, testset, batch_size, seed)\n",
        "    loss_fn = nn.CrossEntropyLoss()\n",
        "    optimizer = torch.optim.Adam(net.parameters(), lr=lr)\n",
        "    history = {key: [] for key in\n",
        "               (\"epoch\", \"train_loss\", \"train_acc\", \"test_loss\", \"test_acc\")}\n",
        "    start_epoch = 1\n",
        "    if saved is not None:\n",
        "        net.load_state_dict(saved[\"model_state\"])\n",
        "        optimizer.load_state_dict(saved[\"optimizer_state\"])\n",
        "        history = saved[\"history\"]\n",
        "        start_epoch = saved[\"epoch\"] + 1\n",
        "        torch.set_rng_state(saved[\"torch_rng\"])\n",
        "        train_iter.generator.set_state(saved[\"loader_rng\"])\n",
        "        cuda_rng = saved[\"cuda_rng\"]\n",
        "        if (device.type == \"cuda\" and cuda_rng is not None\n",
        "                and len(cuda_rng) == torch.cuda.device_count()):\n",
        "            torch.cuda.set_rng_state_all(cuda_rng)\n",
        "        print(f\"Resuming at epoch {start_epoch}: {checkpoint_path}\")\n",
        "\n",
        "    for epoch in range(start_epoch, num_epochs + 1):\n",
        "        net.train()\n",
        "        total_loss, correct, count = 0.0, 0, 0\n",
        "        for X, y in train_iter:\n",
        "            X, y = X.to(device), y.to(device)\n",
        "            optimizer.zero_grad()\n",
        "            logits = net(X)\n",
        "            loss = loss_fn(logits, y)\n",
        "            loss.backward()\n",
        "            optimizer.step()\n",
        "            total_loss += loss.item() * y.size(0)\n",
        "            correct += (logits.argmax(dim=1) == y).sum().item()\n",
        "            count += y.size(0)\n",
        "        test_loss, test_acc = evaluate(net, test_iter, loss_fn, device)\n",
        "        values = (epoch, total_loss / count, correct / count, test_loss, test_acc)\n",
        "        for key, value in zip(history, values):\n",
        "            history[key].append(value)\n",
        "        if checkpoint_path is not None:\n",
        "            _atomic_save(dict(\n",
        "                identity=identity, epoch=epoch, history=history,\n",
        "                model_state=net.state_dict(), optimizer_state=optimizer.state_dict(),\n",
        "                torch_rng=torch.get_rng_state(),\n",
        "                loader_rng=train_iter.generator.get_state(),\n",
        "                cuda_rng=torch.cuda.get_rng_state_all() if device.type == \"cuda\" else None,\n",
        "            ), checkpoint_path)\n",
        "        print(f\"Epoch {epoch:2d}/{num_epochs}: \"\n",
        "              f\"train acc={correct / count:.3%}, test acc={test_acc:.3%}\")\n",
        "\n",
        "    return dict(config=config, history=history, model=net.cpu(),\n",
        "                complete=True,\n",
        "                checkpoint_path=str(checkpoint_path) if checkpoint_path else None,\n",
        "                final_test_acc=history[\"test_acc\"][-1])\n",
        "\n",
        "\n",
        "def run_all_experiments(trainset, testset, seed=42, device=None,\n",
        "                        cache_dir=\"lenet_cache\", resume=True,\n",
        "                        dataset_id=\"fashion_mnist_normalized_v1\"):\n",
        "    \"\"\"Nine independent runs. Each starts from BASELINE, not previous winners.\"\"\"\n",
        "    results = {}\n",
        "    for parameter, options in VARIATIONS.items():\n",
        "        results[parameter] = {}\n",
        "        for option in options:\n",
        "            config = {**BASELINE, parameter: option}\n",
        "            print(f\"\\n--- {parameter} = {option} ---\")\n",
        "            results[parameter][option] = run_experiment(\n",
        "                trainset, testset, **config, seed=seed, device=device,\n",
        "                cache_dir=cache_dir, resume=resume, dataset_id=dataset_id,\n",
        "                run_id=f\"{parameter}={option}\")\n",
        "    return results\n",
        "\n",
        "\n",
        "def best_options(results):\n",
        "    \"\"\"Final-epoch test accuracy only; ties select the first listed option.\"\"\"\n",
        "    return {\n",
        "        parameter: max(runs, key=lambda option: runs[option][\"final_test_acc\"])\n",
        "        for parameter, runs in results.items()\n",
        "    }\n",
        "\n",
        "\n",
        "def summary_rows(results):\n",
        "    \"\"\"Records suitable for pd.DataFrame(summary_rows(results)).\"\"\"\n",
        "    winners = best_options(results)\n",
        "    return [\n",
        "        dict(experiment=parameter, option=option,\n",
        "             **run[\"config\"],\n",
        "             final_train_acc=run[\"history\"][\"train_acc\"][-1],\n",
        "             final_test_acc=run[\"final_test_acc\"],\n",
        "             selected=(option == winners[parameter]))\n",
        "        for parameter, runs in results.items()\n",
        "        for option, run in runs.items()\n",
        "    ]\n",
        "\n",
        "\n",
        "def _plot_runs(runs, title):\n",
        "    fig, ax = plt.subplots(figsize=(9, 5))\n",
        "    for index, (label, run) in enumerate(runs.items()):\n",
        "        h = run[\"history\"]\n",
        "        color = f\"C{index}\"\n",
        "        ax.plot(h[\"epoch\"], h[\"train_acc\"], color=color, linestyle=\"--\",\n",
        "                label=f\"{label}: train\")\n",
        "        ax.plot(h[\"epoch\"], h[\"test_acc\"], color=color, linestyle=\"-\",\n",
        "                marker=\"o\", label=f\"{label}: test\")\n",
        "    ax.set(xlabel=\"Epoch\", ylabel=\"Accuracy\", title=title, ylim=(0, 1))\n",
        "    ax.legend(fontsize=8)\n",
        "    ax.grid(alpha=0.25)\n",
        "    fig.tight_layout()\n",
        "    return fig\n",
        "\n",
        "\n",
        "def plot_experiments(results):\n",
        "    \"\"\"Three comparison figures plus one figure with each experiment's winner.\"\"\"\n",
        "    figures = [_plot_runs(runs, f\"Varying {parameter}\")\n",
        "               for parameter, runs in results.items()]\n",
        "    winners = best_options(results)\n",
        "    best_runs = {f\"{parameter}={option}\": results[parameter][option]\n",
        "                 for parameter, option in winners.items()}\n",
        "    figures.append(_plot_runs(best_runs, \"Best option from each experiment\"))\n",
        "    plt.show()\n",
        "    return figures\n"
      ],
      "execution_count": 1,
