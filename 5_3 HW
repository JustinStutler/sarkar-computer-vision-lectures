        "id": "6YmzXLZV1ELo"
      },
      "source": [
        "## Training metrics\n",
        "\n",
        "Adapted from notes to track accuracy and train for each epoch."
      ],
      "id": "6YmzXLZV1ELo"
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "cg3IMIAm1ELp"
      },
      "source": [
        "# Taken from notes\n",
        "# Track sample-weighted totals.\n",
        "class Accumulator:\n",
        "    # Taken from notes\n",
        "    def __init__(self, n):\n",
        "        self.data = [0.0] * n\n",
        "\n",
        "    # Taken from notes\n",
        "    def add(self, *args):\n",
        "        self.data = [a + float(b) for a, b in zip(self.data, args)]\n",
        "\n",
        "    # Taken from notes\n",
        "    def reset(self):\n",
        "        self.data = [0.0] * len(self.data)\n",
        "\n",
        "    # Taken from notes\n",
        "    def __getitem__(self, idx):\n",
        "        return self.data[idx]\n",
        "\n",
        "\n",
        "# Taken from notes\n",
        "# Count correct predictions.\n",
        "def accuracy(y_hat, y):\n",
        "    if len(y_hat.shape) > 1 and y_hat.shape[1] > 1:\n",
        "        y_hat = y_hat.argmax(axis=1)\n",
        "    cmp = y_hat.type(y.dtype) == y\n",
        "    return float(cmp.type(y.dtype).sum())\n",
        "\n",
        "\n",
        "# Adapted from notes\n",
        "# Learn from one dataset pass.\n",
        "def train_one_epoch(net, train_iter, loss, updater, device):\n",
        "    net.train()\n",
        "    metric = Accumulator(3)\n",
        "    for X, y in train_iter:\n",
        "        X, y = X.to(device), y.to(device)\n",
        "        y_hat = net(X)\n",
        "        l = loss(y_hat, y)\n",
        "        updater.zero_grad()\n",
        "        l.backward()\n",
        "        updater.step()\n",
        "        metric.add(l.item() * len(y), accuracy(y_hat, y), y.numel())\n",
        "    return metric[0] / metric[2], metric[1] / metric[2]"
      ],
      "execution_count": 5,
      "outputs": [],
      "id": "cg3IMIAm1ELp"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "h0H9HZhA1ELp"
      },
      "source": [
        "## Training a run\n",
        "Submission includes saved runs to skip re-training."
      ],
      "id": "h0H9HZhA1ELp"
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "lDz3kQGP1ELp"
      },
      "source": [
        "# Created for training one configuration\n",
        "# Train one configuration.\n",
        "def run_experiment(\n",
        "    trainset, testset, *, batch_size=32, initialization=\"xavier_normal\",\n",
        "    activation=\"sigmoid\", lr=0.001, num_epochs=10, seed=42, device=None\n",
        "):\n",
        "    if num_epochs < 1 or len(trainset) == 0 or len(testset) == 0:\n",
        "        raise ValueError(\"Use positive epochs and nonempty datasets.\")\n",
        "    config = dict(\n",
        "        batch_size=batch_size, initialization=initialization, activation=activation,\n",
        "        lr=lr, num_epochs=num_epochs, optimizer=\"Adam\", seed=seed\n",
        "    )\n",
        "    torch.manual_seed(seed)\n",
        "    if torch.cuda.is_available():\n",
        "        torch.cuda.manual_seed_all(seed)\n",
        "    device = torch.device(device or (\"cuda:0\" if torch.cuda.is_available() else \"cpu\"))\n",
        "    net = Lenet(activation)\n",
        "    initialize_weights(net, initialization)\n",
        "    net.to(device)\n",
        "    train_iter, test_iter = make_loaders(trainset, testset, batch_size, seed)\n",
        "    loss_fn = nn.CrossEntropyLoss()\n",
        "    optimizer = torch.optim.Adam(net.parameters(), lr=lr)\n",
        "    history = {key: [] for key in (\n",
        "        \"epoch\", \"train_loss\", \"train_acc\", \"test_loss\", \"test_acc\"\n",
        "    )}\n",
        "\n",
        "    for epoch in range(1, num_epochs + 1):\n",
        "        train_loss, train_acc = train_one_epoch(\n",
        "            net, train_iter, loss_fn, optimizer, device\n",
        "        )\n",
        "        test_loss, test_acc = evaluate(net, test_iter, loss_fn, device)\n",
        "        values = (epoch, train_loss, train_acc, test_loss, test_acc)\n",
        "        for key, value in zip(history, values):\n",
        "            history[key].append(value)\n",
        "        print(f\"Epoch {epoch:2d}/{num_epochs}: \"\n",
        "              f\"train acc={train_acc:.3%}, test acc={test_acc:.3%}\")\n",
        "\n",
        "    return dict(\n",
        "        config=config, history=history, model=net.cpu(), complete=True,\n",
        "        final_test_acc=history[\"test_acc\"][-1]\n",
        "    )"
      ],
      "execution_count": 6,
      "outputs": [],
      "id": "lDz3kQGP1ELp"
